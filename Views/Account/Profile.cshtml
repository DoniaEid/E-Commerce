```cshtml
@using System.Security.Claims

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";

    var name = User.FindFirstValue(ClaimTypes.Name) ?? "";
    var fullName = name.Split('_', 2);

    var firstName = fullName.Length > 0 ? fullName[0] : "";
    var lastName = fullName.Length > 1 ? fullName[1] : "";

    var phone = User.FindFirstValue(ClaimTypes.MobilePhone) ?? "";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? "";
    var address = User.FindFirstValue(ClaimTypes.StreetAddress) ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ProfileStyle.css" asp-append-version="true" />
}

<main class="profile-page-container">
    <h1 class="page-title">My Profile</h1>

    <div class="profile-layout">

        <!-- Sidebar Navigation -->
        <aside class="profile-sidebar">
            <div class="sidebar-user">
                <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop"
                     alt="Profile">

                <div class="sidebar-user-info">
                    <span class="hello-text">Hello 👋</span>
                    <h3>@firstName @lastName</h3>
                </div>
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Account"
                       asp-action="ShowProfile"
                       class="active">
                        <i class="fa-regular fa-user"></i>
                        Personal Information
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fa-solid fa-box"></i>
                        My Orders
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fa-regular fa-heart"></i>
                        My Wishlists
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fa-solid fa-location-dot"></i>
                        Manage Addresses
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fa-regular fa-credit-card"></i>
                        Saved Cards
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fa-regular fa-bell"></i>
                        Notifications
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fa-solid fa-gear"></i>
                        Settings
                    </a>
                </li>
            </ul>
        </aside>

        <div class="profile-content">

            <form asp-controller="Account"
                  asp-action="EditProfileUser"
                  method="post"
                  id="profileForm"
                  class="profile-form-container">

                <div class="profile-header-card">

                    <div class="user-avatar-wrap">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop"
                             alt="Profile">

                        <button type="button" class="avatar-edit-btn">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                    </div>

                    <button type="submit"
                            id="saveChangesBtn"
                            class="btn-save-changes">

                        <i class="fa-solid fa-check"></i>
                        Save Changes
                    </button>

                </div>

                <div class="profile-form">

                    <div class="form-row">

                        <div class="form-group">
                            <label>First Name</label>

                            <input type="text"
                                   name="First_Name"
                                   value="@firstName"
                                   class="profile-input">
                        </div>

                        <div class="form-group">
                            <label>Last Name</label>

                            <input type="text"
                                   name="Last_Name"
                                   value="@lastName"
                                   class="profile-input">
                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label>Phone Number</label>

                            <input type="text"
                                   name="PhoneNumber"
                                   value="@phone"
                                   class="profile-input">
                        </div>

                        <div class="form-group">
                            <label>Email Address</label>

                            <input type="email"
                                   name="Email"
                                   value="@email"
                                   class="profile-input">
                        </div>

                    </div>

                    <div class="form-row full-width">

                        <div class="form-group">
                            <label>Address</label>

                            <input type="text"
                                   name="Address"
                                   value="@address"
                                   class="profile-input">
                        </div>

                    </div>

                </div>

                <div id="successMessage" class="success-alert">
                    <i class="fa-solid fa-circle-check"></i>
                    تم تعديل البيانات بنجاح!
                </div>

            </form>

        </div>
    </div>
</main>

@section Scripts {

    <script>
        const saveChangesBtn = document.getElementById('saveChangesBtn');
        const successMessage = document.getElementById('successMessage');

        saveChangesBtn.addEventListener('click', function () {

            setTimeout(function () {
                successMessage.classList.add('show');
            }, 500);

            setTimeout(function () {
                successMessage.classList.remove('show');
            }, 3000);

        });
    </script>
}
```
