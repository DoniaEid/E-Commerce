


@model List<Product>

@if (Model.Count() == 0)
{
    <div class="no-products">
        <i class="fa-solid fa-box-open"></i>
        <h3>No Products Found</h3>
        <p>Sorry, we couldn't find any products matching your filter.</p>
        <button onclick="GetAll()" class="show-all-btn">
            Show All Products
        </button>
    </div>
}
else{
   <div class="products-grid-container">
   
    @foreach (var p in Model)
    {
        <div class="product-item-card">
                <div class="product-img-box">
                    <img src="@p.ImageUrl" alt="Dress">

                        <div class="product-badges">

                            <a asp-controller="ProductDetails"
                               asp-action="AddToFavorite"
                               asp-route-productId="@p.Id"
                               class="badge-icon">

                                <i class="fa-regular fa-heart"></i>

                            </a>

                        <a asp-controller="Product"
                           asp-action="GetProductById"
                           asp-route-id="@p.Id"
                           class="badge-icon">

                            <i class="fa-regular fa-eye"></i>

                        </a>

                    </div>
                </div>

                <div class="product-info-box">
                    <span class="cat-name">@p.Name</span>
                    <h3 class="prod-name"> @p.Category.Name</h3>
                    <div class="prod-footer">
                        <div class="prices">
                            <span class="current">$@p.NewPrice</span>
                            <span class="old">$@p.OldPrice</span>
                        </div>
                        <button class="add-btn"><i class="fa-solid fa-bag-shopping"></i> Add</button>
                    </div>
                </div>
            </div>


            }

      </div>
}



