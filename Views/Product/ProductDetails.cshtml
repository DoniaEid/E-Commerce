@section Scripts {
    <script>
        // Product gallery
        document.querySelectorAll(".pd-thumb").forEach(function (thumb) {
            thumb.addEventListener("click", function () {
                document.getElementById("mainProductImage").src = this.dataset.image;
                document.querySelectorAll(".pd-thumb").forEach(x => x.classList.remove("active"));
                this.classList.add("active");
            });
        });

        // Color selection
        document.querySelectorAll(".pd-color").forEach(function (color) {
            color.addEventListener("click", function () {
                document.querySelectorAll(".pd-color").forEach(x => x.classList.remove("selected"));
                this.classList.add("selected");
            });
        });

        // Size selection
        document.querySelectorAll(".pd-size").forEach(function (size) {
            size.addEventListener("click", function () {
                document.querySelectorAll(".pd-size").forEach(x => x.classList.remove("selected"));
                this.classList.add("selected");
            });
        });

        // Quantity
        let quantity = 1;
        const qtyValue = document.getElementById("qtyValue");
        document.getElementById("qtyMinus").addEventListener("click", function () {
            quantity = Math.max(1, quantity - 1);
            qtyValue.textContent = quantity;
        });
        document.getElementById("qtyPlus").addEventListener("click", function () {
            quantity++;
            qtyValue.textContent = quantity;
        });

        // Demo buttons only: connect these to your MVC actions later.
        document.getElementById("addToCart").addEventListener("click", function () {
            document.getElementById("productMessage").textContent =
                "Demo only: connect this button to your AddToCart action.";
        });
        document.getElementById("wishlistButton").addEventListener("click", function () {
            this.classList.toggle("active");
            this.innerHTML = this.classList.contains("active")
                ? '<i class="fa-solid fa-heart"></i>'
                : '<i class="fa-regular fa-heart"></i>';
        });

        // Tabs
        document.querySelectorAll(".pd-tab").forEach(function (tab) {
            tab.addEventListener("click", function () {
                document.querySelectorAll(".pd-tab").forEach(x => x.classList.remove("active"));
                document.querySelectorAll(".pd-tab-content").forEach(x => x.hidden = true);
                this.classList.add("active");
                document.getElementById(this.dataset.tab).hidden = false;
            });
        });
    </script>
}
