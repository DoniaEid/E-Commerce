@{
    ViewData["Title"] = "Product Details";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
}
@model ProductViewModel
<div class="pd-page">
    <div class="pd-breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a><span>›</span>
        <a asp-controller="Product" asp-action="Index">Shop</a><span>›</span>
        <span>Women Textured Handheld Bag</span>
    </div>

    <section class="pd-product">
        <div class="pd-gallery">
            <div class="pd-main-image">
                <img id="mainProductImage"
                     src="https://images.unsplash.com/photo-1599255068390-206e0d068a6b?auto=format&fit=crop&w=900&q=85"
                     alt="Product image" />
            </div>
            <div class="pd-thumbnails">
                <button class="pd-thumb active" type="button" aria-label="View product image 1"
                        data-image="https://images.unsplash.com/photo-1599255068390-206e0d068a6b?auto=format&fit=crop&w=900&q=85">
                    <img src="https://images.unsplash.com/photo-1599255068390-206e0d068a6b?auto=format&fit=crop&w=200&q=80" alt="" />
                </button>
                <button class="pd-thumb" type="button" aria-label="View product image 2"
                        data-image="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?auto=format&fit=crop&w=900&q=85">
                    <img src="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?auto=format&fit=crop&w=200&q=80" alt="" />
                </button>
                <button class="pd-thumb" type="button" aria-label="View product image 3"
                        data-image="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&w=900&q=85">
                    <img src="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&w=200&q=80" alt="" />
                </button>
                <button class="pd-thumb" type="button" aria-label="View product image 4"
                        data-image="https://images.unsplash.com/photo-1583743814966-8936f37f4678?auto=format&fit=crop&w=900&q=85">
                    <img src="https://images.unsplash.com/photo-1583743814966-8936f37f4678?auto=format&fit=crop&w=200&q=80" alt="" />
                </button>
            </div>
        </div>

        <div class="pd-info">
            <div class="pd-title-row">
                <h3>@Model.CategoryName</h3>
                @if (Model.NumberInStock > 0)
                {
                    <span class="pd-stock in-stock">In Stock</span>
                }
                else
                {
                    <span class="pd-stock out-stock">Out Of Stock</span>
                }
            </div>
            <p class="pd-subtitle">@Model.Name</p>

            <div class="pd-rating">
                <span class="pd-stars" aria-label="5 out of 5 stars">★★★★★</span>
                <span class="pd-reviews">(121 Reviews)</span>
            </div>

            <div class="pd-price"><span>$@Model.NewPrice</span><del>$@Model.OldPrice</del></div>

            <p class="pd-description">
                @Model.Description
            </p>

            @if (Model.colors.Any() && Model.sizes.Any()) {

            <div class="pd-option-group">
                <h2>Color</h2>
                <div class="pd-colors" role="group" aria-label="Choose a color">
                        @{
                            var Colors = Model.colors;

                        bool isFirstColor = true;
                    }

                   @foreach (var color in Colors)
                    {
                        <button type="button"
                                class="pd-color @(isFirstColor ? "selected" : "")"
                                style="--swatch: @color; background-color: @color;" 
                                aria-label="@color"
                                onclick="selectOption(this, '.pd-color')">
                        </button>
                        isFirstColor = false;
                    }
                </div>
            </div>

            <div class="pd-option-group">
                <h2>Size</h2>
                <div class="pd-sizes" role="group" aria-label="Choose a size">
                        @{
                            var Sizes = Model.sizes;

                        bool isFirstSize = true;
                    }
                    @foreach (var size in Sizes)
                    {
                        <button type="button"
                                class="pd-size @(isFirstSize ? "selected" : "")"
                                onclick="selectOption(this, '.pd-size')">
                            @size
                        </button>
                        isFirstSize = false;
                    }
                </div>
             
            </div>
            }
           else{    
            
                <div class="availability-message">
                    No colors or sizes are currently available for this product.
                </div>
            }
            <div class="pd-actions">
                <div class="pd-quantity" aria-label="Quantity selector">
                    <button type="button" id="qtyMinus" aria-label="Decrease quantity">−</button>
                    <span id="qtyValue">1</span>
                    <button type="button" id="qtyPlus" aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="pd-add-cart" id="addToCart">Add to Cart</button>
                <button type="button" class="pd-wishlist" id="wishlistButton" aria-label="Add to wishlist">
                    <i class="fa-regular fa-heart"></i>
                </button>
            </div>
            <p class="pd-message" id="productMessage" aria-live="polite"></p>
        </div>
    </section>
    ```cshtml
    <div class="pd-tab-content" id="reviews" hidden>

        <div class="reviews-layout">

            <!-- Reviews List -->
            <div class="reviews-list">
                <h2>Customer Reviews</h2>
                <p class="reviews-subtitle">
                    See what customers think about this product.
                </p>

                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    @foreach (var item in Model.Reviews)
                    {
                        <div class="review-card">

                            <div class="review-header">
                                <div class="review-avatar">
                                    <i class="fa-regular fa-user"></i>
                                </div>

                                <div class="review-user-info">
                                    <h3>
                                        @(item.user.UserName )
                                    </h3>

                                    <div class="review-stars">
                                        @(new string('★', item.NumberStars))
                                        @(new string('☆', 5 - item.NumberStars))
                                    </div>
                                </div>
                            </div>

                            <p class="review-text">@item.review</p>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-reviews">
                        <i class="fa-regular fa-comment-dots"></i>
                        <h3>No reviews yet</h3>
                        <p>Be the first to share your experience!</p>
                    </div>
                }
            </div>

            <!-- Add Review Form -->
            <div class="review-form-wrapper">
                <form asp-controller="Product"
                      asp-action="AddReview"
                      method="post"
                      class="review-form">

                    <h2>Write a Review</h2>
                    <p>We'd love to hear your thoughts about this product.</p>

                    <input type="hidden"
                           name="productId"
                           value="@Model.id" />

                    <label for="review">Your Review</label>

                    <textarea id="review"
                              name="review"
                              placeholder="Tell us about your experience..."
                              required
                              maxlength="1000"></textarea>

                    <label for="numberStars">Your Rating</label>

                    <select id="numberStars" name="numberStars" required>
                        <option value="" disabled selected>
                            Select your rating
                        </option>
                        <option value="5">★★★★★ — Excellent</option>
                        <option value="4">★★★★☆ — Very Good</option>
                        <option value="3">★★★☆☆ — Good</option>
                        <option value="2">★★☆☆☆ — Fair</option>
                        <option value="1">★☆☆☆☆ — Poor</option>
                    </select>

                    <button type="submit">
                        Submit Review
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>

                </form>
            </div>

        </div>
    </div>
    

