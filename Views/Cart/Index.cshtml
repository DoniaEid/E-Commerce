@model IEnumerable<E_Commerce.Models.CartDetailsViewModel>
@using System.Globalization

@{
    ViewData["Title"] = "Checkout";

    var egyptCulture = CultureInfo.GetCultureInfo("en-EG");

    decimal subtotal = Model.Sum(m => m.Totalprice ?? 0);
    decimal deliveryCharge = 5.00m;
    decimal grandTotal = subtotal + deliveryCharge;

    var groups = Model
        .GroupBy(m => new { m.ProductName, m.ImageUrl })
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/CartStyle.css" asp-append-version="true" />
}

<div class="container checkout-container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="checkout-title mb-1">Checkout</h2>
            <p class="text-muted">
                Review your items before placing your order.
            </p>
        </div>

        <span class="text-muted fw-semibold">
            <i class="bi bi-bag"></i>
            <span id="itemsCount">@Model.Sum(m => m.Quantity)</span> Items
        </span>
    </div>

    <div class="row g-4">

        <!-- Products -->
        <div class="col-lg-8">

            <div class="checkout-card">

                <h5>Your Shopping Bag</h5>

                @foreach (var group in groups)
                {
                    decimal groupTotal = group.Sum(x => x.Totalprice ?? 0);

                    <div class="product-group">

                        <img src="/Images/@group.Key.ImageUrl"
                             alt="@group.Key.ProductName"
                             class="product-img" />

                        <div class="pg-body">

                            <div class="pg-header">
                                <div class="product-name">@group.Key.ProductName</div>

                                <div class="pg-total">
                                    <small>Product total</small>
                                    <strong class="group-total">@groupTotal.ToString("#,0.##", egyptCulture) EGP</strong>
                                </div>
                            </div>

                            @foreach (var item in group)
                            {
                                decimal unitPrice = item.Quantity > 0
                                    ? (item.Totalprice ?? 0) / item.Quantity
                                    : 0;

                                <div class="variant"
                                     data-unit-price="@unitPrice.ToString(CultureInfo.InvariantCulture)">

                                    <div class="variant-info">
                                        <span class="chip chip-size">@item.size</span>

                                        <span class="chip">
                                            <span class="color-dot"
                                                  style="background-color:@item.color"></span>
                                            @item.color
                                        </span>
                                    </div>

                                    <div class="variant-price">
                                        @unitPrice.ToString("#,0.##", egyptCulture) EGP
                                    </div>

                                    <div class="variant-qty">
                                        <div class="quantity-box"
                                             data-product="@item.ProductName"
                                             data-size="@item.size"
                                             data-color="@item.color">

                                            <button type="button" class="quantity-btn"
                                                    onclick="ChangeQuantityProduct(this, -1)">
                                                −
                                            </button>

                                            <span class="quantity-number">@item.Quantity</span>

                                            <button type="button" class="quantity-btn"
                                                    onclick="ChangeQuantityProduct(this, 1)">
                                                +
                                            </button>

                                        </div>
                                    </div>

                                    <div class="variant-total">
                                        @((item.Totalprice ?? 0).ToString("#,0.##", egyptCulture)) EGP
                                    </div>
                                    <form asp-controller="Cart" asp-action="DeleteItemInCart" method="get" class="variant-delete">

                                        <input type="hidden" name="ProductName" value="@item.ProductName" />
                                        <input type="hidden" name="Size" value="@item.size" />
                                        <input type="hidden" name="Color" value="@item.color" />

                                        <button type="submit" class="delete-btn" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </form>
                                </div>
                            }

                        </div>

                    </div>
                }

            </div>

        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">

            <div class="summary-card">

                <h5 class="summary-title">Order Summary</h5>

                <div class="summary-row">
                    <span>Subtotal</span>
                    <strong id="subtotal">@subtotal.ToString("#,0.##", egyptCulture) EGP</strong>
                </div>

                <div class="mb-4">
                    <label class="form-label">Discount Code</label>

                    <div class="input-group">
                        <input type="text"
                               class="form-control discount-input"
                               placeholder="Enter code" />

                        <button class="btn discount-btn" type="button">Apply</button>
                    </div>
                </div>

                <div class="summary-row">
                    <span>Delivery Charge</span>
                    <strong>@deliveryCharge.ToString("#,0.##", egyptCulture) EGP</strong>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
                    <span class="summary-total">Grand Total</span>
                    <span class="summary-total-price"
                          id="grandTotal"
                          data-delivery="@deliveryCharge.ToString(CultureInfo.InvariantCulture)">
                        @grandTotal.ToString("#,0.##", egyptCulture) EGP
                    </span>
                </div>

                <button class="checkout-btn" type="button">
                    Proceed to Checkout
                    <i class="bi bi-arrow-right ms-2"></i>
                </button>

                <div class="text-center mt-3">
                    <span class="secure-label">
                        <i class="bi bi-shield-check"></i>
                        Secure Checkout
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        function fmt(n) {
            return n.toLocaleString('en-US', {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            }) + ' EGP';
        }

        function recalcTotals() {
            let subtotal = 0;
            let items = 0;

            document.querySelectorAll('.product-group').forEach(group => {
                let groupTotal = 0;

                group.querySelectorAll('.variant').forEach(v => {
                    const unit  = parseFloat(v.dataset.unitPrice);
                    const qty   = parseInt(v.querySelector('.quantity-number').textContent, 10);
                    const total = unit * qty;

                    v.querySelector('.variant-total').textContent = fmt(total);
                    groupTotal += total;
                    items += qty;
                });

                group.querySelector('.group-total').textContent = fmt(groupTotal);
                subtotal += groupTotal;
            });

            const grand    = document.getElementById('grandTotal');
            const delivery = parseFloat(grand.dataset.delivery);

            document.getElementById('subtotal').textContent   = fmt(subtotal);
            grand.textContent                                 = fmt(subtotal + delivery);
            document.getElementById('itemsCount').textContent = items;
        }

      


    </script>
}